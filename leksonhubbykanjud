local function ProcessCollisionPart(part)
    if part:IsA("BasePart") and not part.Anchored and not ProtectionEngine.AntiCollision.Parts[part] then
        ProtectionEngine.AntiCollision.Parts[part] = true
        part.CanCollide = false
    end
end

function ProtectionEngine.ToggleAntiCollision(state)
    ProtectionEngine.AntiCollision.Active = state
    if state then
        for _, f in ipairs(workspace:GetDescendants()) do ProcessCollisionPart(f) end
        ProtectionEngine.AntiCollision.Connection = workspace.DescendantAdded:Connect(ProcessCollisionPart)
    else
        if ProtectionEngine.AntiCollision.Connection then
            ProtectionEngine.AntiCollision.Connection:Disconnect()
            ProtectionEngine.AntiCollision.Connection = nil
        end
        for d in pairs(ProtectionEngine.AntiCollision.Parts) do
            if d and d.Parent then d.CanCollide = true end
        end
        ProtectionEngine.AntiCollision.Parts = {}
    end
end

