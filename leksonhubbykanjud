    TweenService:Create(barFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 1, 0)}):Play()

    local startTime = tick()
    while tick() - startTime < duration do
        local progress = math.clamp(math.floor(((tick() - startTime) / duration) * 100), 0, 100)
        percentText.Text = progress .. "%"
        task.wait(0.03)
    end
    percentText.Text = "100%"
    
    activeGlitch = false
    for _, data in ipairs(letterLabels) do
        data.g1.TextTransparency = 1 data.g2.TextTransparency = 1
        data.g1.Position = UDim2.new(0, data.origX, 0, 0) data.g2.Position = UDim2.new(0, data.origX, 0, 0)
    end
    
    -- Particle burst saat selesai
    for i = 1, 30 do
        local particle = Create("Frame", background, {
            Size = UDim2.new(0, 4, 0, 4),
            Position = UDim2.new(0.5, 0, 0.5, 20),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            ZIndex = 10
        }, 2)
        local angle = math.random() * math.pi * 2
        local distance = math.random(100, 400)
        local targetX = math.cos(angle) * distance
        local targetY = math.sin(angle) * distance
        TweenService:Create(particle, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, targetX, 0.5, 20 + targetY),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0)
        }):Play()
        task.delay(0.9, function() particle:Destroy() end)
    end
    
    task.wait(0.4)

    -- Fade out
    local fadeInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(background, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(logoImage, fadeInfo, {ImageTransparency = 1}):Play()
    TweenService:Create(boxContainer, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(barFill, fadeInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(percentText, fadeInfo, {TextTransparency = 1}):Play()
    TweenService:Create(typingText, fadeInfo, {TextTransparency = 1}):Play()

    for _, data in ipairs(letterLabels) do
        TweenService:Create(data.main, fadeInfo, {TextTransparency = 1, Position = UDim2.new(0, data.origX, 0, -50)}):Play()
    end

    task.wait(0.6)
    screenGui:Destroy()

    applyButtonAnimation()
    startHubMain()
end)
