local function detectMandrakeSkin(targetPlayer)
    local char = targetPlayer.Character
    if not char then return false end
    
    local humanoid = char:FindFirstChild("Humanoid")
    local description = humanoid and humanoid:GetAppliedDescription()
    if not description then return false end

    local isMuscular = (description.Torso == 1 or description.Torso == 0)
    local hasLuxItems = false
    local success, appearance = pcall(function() return targetPlayer:GetCharacterAppearanceAsync() end)
    if success and appearance then
        for _, item in pairs(appearance:GetChildren()) do
            local n = string.lower(item.Name)
            if string.find(n, "louis") or string.find(n, "vuitton") or string.find(n, "mandrake") or string.find(n, "luxo") then
                hasLuxItems = true
                break
            end
        end
    end

    return hasLuxItems or isMuscular
end

