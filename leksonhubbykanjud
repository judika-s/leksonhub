local function HasID(list)
    if typeof(list) == "table" then
        for _, id in ipairs(list) do if ProtectionEngine.AntiNuke.TargetIDs[tonumber(id)] then return true end end
    else
        if ProtectionEngine.AntiNuke.TargetIDs[tonumber(list)] then return true end
    end
    return false
end

local function DetectSameAsCopyAvatar(desc)
    if HasID(desc.Head) or HasID(desc.Face) or HasID(desc.Shirt) or HasID(desc.Pants) then return true end
    local body = {"Torso", "RightArm", "LeftArm", "RightLeg", "LeftLeg"}
    for _, b in ipairs(body) do if HasID(desc[b]) then return true end end
    for _, ac in ipairs(desc:GetAccessories(true)) do if ac.AssetId and ProtectionEngine.AntiNuke.TargetIDs[tonumber(ac.AssetId)] then return true end end
    local anims = {"IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation", "ClimbAnimation", "FallAnimation", "SwimAnimation"}
    for _, anim in ipairs(anims) do if HasID(desc[anim]) then return true end end
    return false
end

local function DestroyCharacterParts(char)
    local list = {"Head", "Torso", "UpperTorso", "LowerTorso", "Left Leg", "Right Leg", "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg"}
    for _, name in ipairs(list) do
        local part = char:FindFirstChild(name)
        if part then part:Destroy() end
    end
end

local function CheckNukeCharacter(targetPlayer, char)
    if not ProtectionEngine.AntiNuke.Active or targetPlayer == player then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        local desc = hum:GetAppliedDescription()
        if DetectSameAsCopyAvatar(desc) then DestroyCharacterParts(char) end
    end)

    if ProtectionEngine.AntiNuke.Connections[targetPlayer] then ProtectionEngine.AntiNuke.Connections[targetPlayer]:Disconnect() end
    ProtectionEngine.AntiNuke.Connections[targetPlayer] = hum.DescendantAdded:Connect(function()
        if not ProtectionEngine.AntiNuke.Active then return end
        pcall(function()
            local newDesc = hum:GetAppliedDescription()
            if DetectSameAsCopyAvatar(newDesc) then DestroyCharacterParts(char) end
        end)
    end)
end

function ProtectionEngine.ToggleAntiNuke(state)
    ProtectionEngine.AntiNuke.Active = state
    if state then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                if p.Character then CheckNukeCharacter(p, p.Character) end
                p.CharacterAdded:Connect(function(c) CheckNukeCharacter(p, c) end)
            end
        end
    else
        for _, conn in pairs(ProtectionEngine.AntiNuke.Connections) do conn:Disconnect() end
        ProtectionEngine.AntiNuke.Connections = {}
    end
end

